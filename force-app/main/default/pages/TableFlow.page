<apex:page controller="TableFlowController" showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0" applyHtmlTag="false" applyBodyTag="false">
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>TableFlow | Restaurant workspace</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f5f5f0;color:#202e2b;font:14px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer;border:1px solid #d9ded8;border-radius:9px;background:white;color:#263b32;padding:10px 15px;font-weight:650}button:hover{background:#edf3ec}button:disabled{opacity:.5;cursor:wait}button.primary{background:#254d3b;color:white;border-color:#254d3b}.shell{display:grid;grid-template-columns:210px 1fr;min-height:100vh}aside{background:#183e30;color:#e7eee8;padding:32px 20px;position:sticky;top:0;height:100vh}.brand{font-size:27px;font-weight:750;letter-spacing:-1px}.brand span{color:#c9e491}.tag{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#a9bcb0;margin:5px 0 40px}nav button{display:block;width:100%;text-align:left;margin:8px 0;background:transparent;border:0;color:#c6d6ca;padding:13px 15px}nav button.active{background:#e6efda;color:#193b2e}.aside-note{position:absolute;bottom:26px;font-size:12px;color:#a9bcb0;max-width:165px}main{padding:30px 32px;min-width:0}.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;gap:15px}.eyebrow{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#758077}h1{font-size:30px;letter-spacing:-1px;margin:5px 0}h2{font-size:19px;margin:0 0 16px}h3{margin:0 0 6px;font-size:16px}.muted{color:#748078;font-size:12px}.topright{display:flex;gap:12px;align-items:center}.pill{display:inline-block;background:#eef2e5;border-radius:30px;padding:5px 10px;font-size:11px;font-weight:700;color:#496244}.panel{background:white;border:1px solid #e0e5dc;border-radius:15px;padding:22px}.pos{display:grid;grid-template-columns:minmax(0,1fr) 345px;gap:22px}.menu-tools{display:flex;gap:10px;margin-bottom:16px}input,select,textarea{border:1px solid #dce1d9;border-radius:8px;padding:10px 12px;background:#fff;color:#263b32;max-width:100%}input:focus,select:focus,textarea:focus{outline:2px solid #b6d19f}.search{width:100%}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px}.chips button{padding:7px 13px;font-size:12px;border-radius:25px}.chips button.on{background:#254d3b;color:white}.dishes{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:13px}.dish{padding:18px;text-align:left;min-height:158px;border-radius:13px;background:#fff;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between}.dish .icon{font-size:25px;background:#f4f4e9;border-radius:11px;width:45px;height:45px;text-align:center;padding:3px;margin-bottom:12px}.dish strong{font-size:14px}.dish .price{display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:12px}.plus{background:#e7eedc;border-radius:50%;height:25px;width:25px;text-align:center}.cart{position:sticky;top:22px;align-self:start}.cart label,.field label{display:block;font-size:12px;font-weight:650;margin:12px 0 5px}.cart select,.cart textarea{width:100%}.row{display:flex;justify-content:space-between;align-items:center;gap:12px}.cart-line{border-bottom:1px solid #edf0e8;padding:13px 0}.qty{display:flex;align-items:center;gap:9px;margin-top:7px}.qty button{padding:2px 10px}.cart-lines{max-height:260px;overflow:auto;margin:12px 0}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.two input{width:100%}.totals{border-top:1px dashed #cfd9ca;margin-top:18px;padding-top:12px}.totals .row{padding:4px 0}.grand{font-size:21px;font-weight:750;margin:8px 0 16px}.wide{width:100%}.empty{text-align:center;padding:45px 20px;color:#768178}.empty strong{display:block;color:#324a3c;font-size:18px;margin-bottom:8px}.board{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.lane{background:#e9ede4;padding:15px;border-radius:15px;min-height:320px}.ticket{background:white;border:1px solid #dce3d5;padding:18px;border-radius:12px;margin-bottom:13px}.ticket ul{padding-left:18px;margin:12px 0}.ticket .note{background:#fff7dc;padding:8px;border-radius:6px;font-size:12px}.ticket button{width:100%;margin-top:12px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}.stat strong{font-size:30px;display:block;letter-spacing:-1px;margin:9px 0}.stat{padding:22px}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:14px 12px;border-bottom:1px solid #e9ede6;white-space:nowrap}th{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#7d877d}td button{padding:6px 10px;font-size:12px}.table-actions{display:flex;gap:6px}.menu-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:20px}.field input,.field select{width:100%}.field{margin-bottom:15px}.notice{padding:12px 17px;border-radius:9px;margin-bottom:20px;background:#e7f1db;border:1px solid #cfdfbe}.notice.error{background:#fff0e8;color:#963c27;border-color:#efc9b9}.receipt{max-width:420px;margin:auto;font-family:ui-monospace,monospace}.receipt h2{text-align:center;font-size:25px}.receipt .center{text-align:center}.receipt hr{border:0;border-top:1px dashed #aaa;margin:18px 0}dialog{border:0;border-radius:16px;width:500px;max-width:94vw;padding:28px;box-shadow:0 20px 80px #0003}dialog::backdrop{background:#102a2690}.dialog-buttons{display:flex;gap:10px;margin-top:24px}.bar{height:9px;background:#c4d7ac;border-radius:8px;margin-top:6px}.legend{margin-bottom:15px}.status-paid{background:#dff0d1}.status-unpaid{background:#fff0cc}#loading{display:none;position:fixed;bottom:24px;right:24px;padding:12px 20px;background:#193e30;color:white;border-radius:10px;z-index:20}body.busy #loading{display:block}.footer{margin-top:24px;color:#859084;font-size:11px}
@media(max-width:1100px){.shell{grid-template-columns:165px 1fr}aside{padding:25px 12px}main{padding:22px}.pos{grid-template-columns:1fr 310px}.stats{grid-template-columns:repeat(2,1fr)}}@media(max-width:800px){.shell{display:block}aside{position:static;height:auto;padding:14px 20px}.brand{font-size:23px}.tag,.aside-note{display:none}nav{display:flex;overflow:auto}nav button{width:auto;white-space:nowrap;font-size:12px;padding:8px}.pos,.menu-layout,.board{grid-template-columns:1fr}.cart{position:static}.top{align-items:flex-start}.topright{flex-wrap:wrap}.topright .pill{display:none}main{padding:16px}.stats{gap:10px}}
@media print{body *{visibility:hidden}dialog[open],dialog[open] *{visibility:visible}dialog[open]{position:absolute;inset:0;margin:0;width:100%;max-width:none;box-shadow:none}.dialog-buttons{display:none}.receipt{max-width:420px}dialog::backdrop{background:white}}
</style></head>
<body><div class="shell"><aside><div class="brand">Table<span>Flow</span></div><div class="tag">Restaurant workspace</div><nav id="nav"></nav><div class="aside-note">Built on Salesforce<br/>Playground project<br/><br/>Orders stay in your org.</div></aside>
<main><header class="top"><div><div class="eyebrow">YOUR RESTAURANT, IN SYNC</div><h1 id="title">New order</h1><div class="muted" id="subtitle">A smoother service starts here.</div></div><div class="topright"><span class="pill">SALESFORCE CONNECTED</span><button onclick="refresh()">Refresh</button></div></header><div id="message" role="status"></div><div id="content"><div class="empty">Loading your restaurant...</div></div><div class="footer">TableFlow educational project · Amounts use your Salesforce price book currency · Payment entries record an external payment; no money is collected.</div></main></div>
<div id="loading" role="status">Saving to Salesforce...</div>
<dialog id="bill"><div id="receipt" class="receipt"></div><div class="dialog-buttons"><button class="primary" onclick="window.print()">Print bill</button><button onclick="document.getElementById('bill').close()">Close</button></div></dialog>
<script>
//<![CDATA[
'use strict';
let data={menu:[],tickets:[]},view='pos',category='All',search='',busy=false,editId=null;
let draft={token:token(),service:'Dine-in',tableNo:'T01',note:'',discount:0,tax:0,lines:[]};
try{const saved=JSON.parse(sessionStorage.getItem('tableflowDraft'));if(saved&&Array.isArray(saved.lines))draft=saved;}catch(e){}
function token(){return Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,12);}
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function money(v){return Number(v||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});}
function store(){sessionStorage.setItem('tableflowDraft',JSON.stringify(draft));}
function message(text,error=false){document.getElementById('message').innerHTML=text?'<div class="notice '+(error?'error':'')+'">'+esc(text)+'</div>':'';}
function remote(action,payload,after){
 if(busy)return;busy=true;document.body.classList.add('busy');document.querySelectorAll('button').forEach(b=>b.disabled=true);
 Visualforce.remoting.Manager.invokeAction('{!$RemoteAction.TableFlowController.invoke}',action,JSON.stringify(payload||{}),function(result,event){
  busy=false;document.body.classList.remove('busy');document.querySelectorAll('button').forEach(b=>b.disabled=false);
  if(!event.status){message(event.message||'Connection failed. Retry after refreshing your Trailhead session.',true);return;}
  try{const response=JSON.parse(result);if(!response.ok){message(response.error,true);return;}
   data=response.data;data.tickets.forEach(t=>{t.OrderItems=Array.isArray(t.OrderItems)?t.OrderItems:((t.OrderItems||{}).records||[]);try{t.meta=JSON.parse(t.Description);}catch(e){t.meta={};}});
   if(after)after();render();
  }catch(e){message('Could not read the server response: '+e.message,true);}
 },{escape:false,timeout:120000});
}
function refresh(){remote('load',{},()=>message('Restaurant refreshed.'));}
const titles={pos:'New order',kitchen:'Kitchen board',orders:'Orders & billing',menu:'Menu manager',dashboard:'Service overview'};
function navigate(to){view=to;message('');render();}
function render(){
 document.getElementById('title').textContent=titles[view];
 document.getElementById('subtitle').textContent=view==='dashboard'?'Latest 200 orders · '+(data.user||'Restaurant team'):'A smoother service starts here.';
 document.getElementById('nav').innerHTML=Object.keys(titles).map(v=>'<button class="'+(view===v?'active':'')+'" onclick="navigate(\''+v+'\')">'+titles[v]+'</button>').join('');
 ({pos:renderPos,kitchen:renderKitchen,orders:renderOrders,menu:renderMenu,dashboard:renderDashboard})[view]();
}
function findDish(id){return data.menu.find(p=>p.Product2Id===id);}
function totals(){let subtotal=0;draft.lines.forEach(l=>{const p=findDish(l.productId);if(p)subtotal+=p.UnitPrice*l.quantity;});let discount=Math.round(subtotal*Number(draft.discount||0))/100;let tax=Math.round((subtotal-discount)*Number(draft.tax||0))/100;return{subtotal,discount,tax,total:subtotal-discount+tax};}
function icon(cat){return({Starters:'◈',Mains:'◉',Breads:'▱',Drinks:'◡',Desserts:'◇'})[cat]||'◈';}
function renderPos(){
 document.getElementById('content').innerHTML='<div class="pos"><section><div class="menu-tools"><input id="search" class="search" placeholder="Search a dish..." aria-label="Search menu" value="'+esc(search)+'" oninput="search=this.value;renderDishes()"/></div><div id="chips" class="chips"></div><div id="dishes" class="dishes"></div></section><section class="panel cart"><div class="row"><h2>Current ticket</h2><span class="pill">NEW</span></div><div class="two"><div><label>Order type</label><select onchange="draft.service=this.value;store();renderCart()">'+['Dine-in','Takeaway','Delivery'].map(s=>'<option '+(s===draft.service?'selected="selected"':'')+'>'+s+'</option>').join('')+'</select></div><div><label>Table</label><select id="tableSelect" onchange="draft.tableNo=this.value;store()">'+Array.from({length:12},(_,i)=>'T'+String(i+1).padStart(2,'0')).map(t=>'<option '+(t===draft.tableNo?'selected="selected"':'')+'>'+t+'</option>').join('')+'</select></div></div><div id="cartLines" class="cart-lines"></div><label>Kitchen notes</label><textarea rows="2" maxlength="400" placeholder="e.g. Mild spice, no onion" onchange="draft.note=this.value;store()">'+esc(draft.note)+'</textarea><div class="two"><div><label>Discount %</label><input type="number" min="0" max="100" value="'+draft.discount+'" onchange="setRate(\'discount\',this)"/></div><div><label>Tax %</label><input type="number" min="0" max="30" value="'+draft.tax+'" onchange="setRate(\'tax\',this)"/></div></div><div id="totals"></div><button class="primary wide" id="send" onclick="submitTicket()">Send to kitchen</button><p class="muted">Tax defaults to 0%. Set the rate required for your demonstration.</p></section></div>';
 renderDishes();renderCart();
}
function renderDishes(){
 const categories=['All',...new Set(data.menu.map(p=>p.Product2.Description||'Other'))];
 document.getElementById('chips').innerHTML=categories.map((c,i)=>'<button class="'+(category===c?'on':'')+'" onclick="chooseCategory('+i+')">'+esc(c)+'</button>').join('');
 const available=data.menu.filter(p=>p.Product2.IsActive&&(category==='All'||p.Product2.Description===category)&&p.Product2.Name.toLowerCase().includes(search.toLowerCase()));
 document.getElementById('dishes').innerHTML=available.map(p=>'<button class="dish" onclick="addDish(\''+p.Product2Id+'\')"><span class="icon">'+icon(p.Product2.Description)+'</span><strong>'+esc(p.Product2.Name)+'</strong><span class="muted">'+esc(p.Product2.Description)+'</span><span class="price">'+money(p.UnitPrice)+'<span class="plus">+</span></span></button>').join('')||(data.menu.length?'<div class="empty">No matching available dishes.</div>':'<div class="panel empty"><strong>Your menu starts here</strong><p>Load 12 sample dishes, then customize them.</p><button class="primary" onclick="remote(\'seed\',{},()=>message(\'Sample menu created.\'))">Load sample menu</button></div>');
}
function chooseCategory(i){category=['All',...new Set(data.menu.map(p=>p.Product2.Description||'Other'))][i];renderDishes();}
function addDish(id){if(busy)return;const line=draft.lines.find(l=>l.productId===id);if(line){if(line.quantity<99)line.quantity++;}else draft.lines.push({productId:id,quantity:1});store();renderCart();}
function quantity(id,delta){if(busy)return;const line=draft.lines.find(l=>l.productId===id);line.quantity+=delta;if(line.quantity<1)draft.lines=draft.lines.filter(l=>l!==line);if(line.quantity>99)line.quantity=99;store();renderCart();}
function setRate(key,el){const n=Number(el.value);draft[key]=Number.isFinite(n)?Math.max(0,Math.min(key==='tax'?30:100,n)):0;el.value=draft[key];store();renderCart();}
function renderCart(){
 document.getElementById('tableSelect').disabled=draft.service!=='Dine-in';
 document.getElementById('cartLines').innerHTML=draft.lines.map(l=>{const p=findDish(l.productId);return '<div class="cart-line"><div class="row"><strong>'+esc(p?p.Product2.Name:'Unavailable dish')+'</strong><span>'+money((p?p.UnitPrice:0)*l.quantity)+'</span></div><div class="qty"><button aria-label="Decrease quantity" onclick="quantity(\''+l.productId+'\',-1)">−</button><span>'+l.quantity+'</span><button aria-label="Increase quantity" onclick="quantity(\''+l.productId+'\',1)">+</button></div></div>';}).join('')||'<div class="empty">Choose dishes to start your ticket.</div>';
 const t=totals();document.getElementById('totals').innerHTML='<div class="totals"><div class="row"><span>Subtotal</span><span>'+money(t.subtotal)+'</span></div><div class="row"><span>Discount</span><span>−'+money(t.discount)+'</span></div><div class="row"><span>Tax</span><span>'+money(t.tax)+'</span></div><div class="row grand"><span>Total</span><span>'+money(t.total)+'</span></div></div>';
 document.getElementById('send').disabled=busy||!draft.lines.length;
}
function submitTicket(){remote('create',draft,()=>{draft={token:token(),service:'Dine-in',tableNo:'T01',note:'',discount:0,tax:0,lines:[]};store();view='kitchen';message('Order saved. The kitchen ticket is ready.');});}
function ticketLines(t){return(t.OrderItems||[]).map(l=>'<li><strong>'+l.Quantity+' ×</strong> '+esc(l.PricebookEntry.Product2.Name)+'</li>').join('');}
function ticketCard(t){const next={New:'Preparing',Preparing:'Ready',Ready:'Served'}[t.meta.stage];return '<article class="ticket"><div class="row"><h3>#'+esc(t.OrderNumber)+'</h3><span class="pill">'+esc(t.meta.service==='Dine-in'?t.meta.tableNo:t.meta.service)+'</span></div><div class="muted">'+new Date(t.CreatedDate).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})+'</div><ul>'+ticketLines(t)+'</ul>'+(t.meta.note?'<div class="note">'+esc(t.meta.note)+'</div>':'')+(next?'<button class="primary" onclick="advance(\''+t.Id+'\',\''+next+'\')">Mark '+next.toLowerCase()+'</button>':'')+'</article>';}
function renderKitchen(){document.getElementById('content').innerHTML='<div class="board">'+['New','Preparing','Ready'].map(s=>{const ts=data.tickets.filter(t=>t.meta.stage===s);return '<section class="lane"><div class="row legend"><h3>'+s+'</h3><span class="pill">'+ts.length+'</span></div>'+ts.map(ticketCard).join('')+(!ts.length?'<div class="empty">No '+s.toLowerCase()+' tickets</div>':'')+'</section>';}).join('')+'</div><p class="muted">Click Refresh to pick up changes made by another staff member.</p>';}
function advance(id,stage){remote('status',{id,stage},()=>message('Kitchen status updated.'));}
function renderOrders(){
 document.getElementById('content').innerHTML='<section class="panel"><div class="row"><h2>Recent orders</h2><span class="muted">Latest 200 tickets</span></div><div class="tablewrap"><table><thead><tr><th>Order</th><th>Service</th><th>Kitchen</th><th>Total</th><th>Payment</th><th>Actions</th></tr></thead><tbody>'+data.tickets.map(t=>'<tr><td><strong>#'+esc(t.OrderNumber)+'</strong><br/><span class="muted">'+new Date(t.CreatedDate).toLocaleString()+'</span></td><td>'+esc(t.meta.service)+(t.meta.service==='Dine-in'?' · '+esc(t.meta.tableNo):'')+'</td><td>'+esc(t.meta.stage)+'</td><td>'+money(t.meta.grandTotal)+'</td><td><span class="pill status-'+(t.meta.payment==='Paid'?'paid':'unpaid')+'">'+esc(t.meta.payment)+'</span><br/><span class="muted">'+esc(t.meta.method)+'</span></td><td><div class="table-actions"><button onclick="showBill(\''+t.Id+'\')">Bill</button>'+(t.meta.payment!=='Paid'?'<select id="pay-'+t.Id+'" aria-label="Payment method"><option>Cash</option><option>Card</option><option>UPI</option></select><button onclick="pay(\''+t.Id+'\')">Record paid</button>':'')+'</div></td></tr>').join('')+'</tbody></table></div>'+(!data.tickets.length?'<div class="empty">Your orders will appear here.</div>':'')+'</section>';
}
function pay(id){const method=document.getElementById('pay-'+id).value;remote('status',{id,method},()=>message('External payment recorded. No payment was charged by this app.'));}
function showBill(id){const t=data.tickets.find(t=>t.Id===id),m=t.meta;document.getElementById('receipt').innerHTML='<h2>TableFlow</h2><div class="center">RESTAURANT BILL<br/>#'+esc(t.OrderNumber)+'<br/>'+new Date(t.CreatedDate).toLocaleString()+'<br/>'+esc(m.service)+' '+esc(m.service==='Dine-in'?m.tableNo:'')+'</div><hr/>'+(t.OrderItems||[]).map(l=>'<div class="row"><span>'+l.Quantity+' × '+esc(l.PricebookEntry.Product2.Name)+'</span><span>'+money(l.TotalPrice)+'</span></div>').join('')+'<hr/><div class="row"><span>Subtotal</span><span>'+money(m.subtotal)+'</span></div><div class="row"><span>Discount '+m.discount+'%</span><span>−'+money(m.discountAmount)+'</span></div><div class="row"><span>Tax '+m.tax+'%</span><span>'+money(m.taxAmount)+'</span></div><div class="row grand"><span>TOTAL</span><span>'+money(m.grandTotal)+'</span></div><hr/><div class="center">'+esc(m.payment)+' '+esc(m.method)+'<br/>Thank you. See you again!<br/><small>Playground demonstration · Salesforce currency</small></div>';document.getElementById('bill').showModal();}
function renderMenu(){
 const p=findDish(editId);document.getElementById('content').innerHTML='<div class="menu-layout"><section class="panel"><h2>Your dishes</h2><div class="tablewrap"><table><thead><tr><th>Dish</th><th>Category</th><th>Price</th><th>Availability</th><th></th></tr></thead><tbody>'+data.menu.map(p=>'<tr><td>'+esc(p.Product2.Name)+'</td><td>'+esc(p.Product2.Description)+'</td><td>'+money(p.UnitPrice)+'</td><td>'+ (p.Product2.IsActive?'Available':'Sold out')+'</td><td><button onclick="editId=\''+p.Product2Id+'\';renderMenu()">Edit</button></td></tr>').join('')+'</tbody></table></div>'+(!data.menu.length?'<div class="empty"><button onclick="remote(\'seed\',{},()=>message(\'Sample menu created.\'))">Load sample menu</button></div>':'')+'</section><form class="panel" onsubmit="saveDish(event)"><h2>'+(p?'Edit dish':'Add a dish')+'</h2><div class="field"><label for="dishName">Dish name</label><input id="dishName" required="required" maxlength="80" value="'+esc(p?p.Product2.Name:'')+'"/></div><div class="field"><label for="dishCat">Category</label><input id="dishCat" required="required" maxlength="40" value="'+esc(p?p.Product2.Description:'Mains')+'"/></div><div class="field"><label for="dishPrice">Price</label><input id="dishPrice" type="number" step=".01" min=".01" max="99999" required="required" value="'+(p?p.UnitPrice:'')+'"/></div><div class="field"><label for="dishActive">Availability</label><select id="dishActive"><option value="true">Available</option><option value="false" '+(p&&!p.Product2.IsActive?'selected="selected"':'')+'>Sold out</option></select></div><button type="submit" class="primary wide">Save dish</button>'+(p?'<button type="button" class="wide" style="margin-top:10px" onclick="editId=null;renderMenu()">Add another dish</button>':'')+'<p class="muted">Price edits apply to new orders. Existing bills keep their original prices.</p></form></div>';
}
function saveDish(event){event.preventDefault();remote('menu',{id:editId,name:document.getElementById('dishName').value,category:document.getElementById('dishCat').value,price:Number(document.getElementById('dishPrice').value),active:document.getElementById('dishActive').value==='true'},()=>{editId=null;message('Menu updated.');});}
function renderDashboard(){
 const all=data.tickets,paid=all.filter(t=>t.meta.payment==='Paid'),open=all.filter(t=>t.meta.stage!=='Served'),revenue=paid.reduce((s,t)=>s+Number(t.meta.grandTotal||0),0);
 const counts={};all.forEach(t=>(t.OrderItems||[]).forEach(l=>{const name=l.PricebookEntry.Product2.Name;counts[name]=(counts[name]||0)+l.Quantity;}));
 const popular=Object.entries(counts).sort((a,b)=>b[1]-a[1]).slice(0,6),max=popular.length?popular[0][1]:1;
 document.getElementById('content').innerHTML='<div class="stats">'+[['Recorded revenue',money(revenue),'Paid tickets in this view'],['Orders',all.length,'Latest 200 orders'],['In service',open.length,'Not yet served'],['Unpaid',all.length-paid.length,'Awaiting payment record']].map(s=>'<div class="panel stat"><span class="muted">'+s[0]+'</span><strong>'+s[1]+'</strong><span class="muted">'+s[2]+'</span></div>').join('')+'</div><div class="two"><section class="panel"><h2>Most ordered dishes</h2>'+popular.map(([n,q])=>'<div style="margin-bottom:18px"><div class="row"><span>'+esc(n)+'</span><strong>'+q+'</strong></div><div class="bar" style="width:'+Math.max(5,q/max*100)+'%"></div></div>').join('')+(!popular.length?'<div class="empty">Place an order to see dish performance.</div>':'')+'</section><section class="panel"><h2>Tables in service</h2><div class="dishes">'+Array.from({length:12},(_,i)=>'T'+String(i+1).padStart(2,'0')).map(table=>{const count=open.filter(t=>t.meta.service==='Dine-in'&&t.meta.tableNo===table).length;return '<div class="ticket"><h3>'+table+'</h3><span class="pill">'+(count?count+' open ticket(s)':'Available')+'</span></div>';}).join('')+'</div></section></div>';
